<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/ic_lifeline_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="@string/app_title"
                android:textColor="@color/amber_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:text="@string/mesh_dispatch_tag"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/account_desc"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_account"
            app:tint="@color/amber_primary" />
    </LinearLayout>

    <!-- Bluetooth & GPS Dashboard Card -->
    <LinearLayout
        android:id="@+id/statusDashboardCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_status_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- Bluetooth Mesh Status Chip Button -->
        <LinearLayout
            android:id="@+id/statusConnectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_amber"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/bluetoothIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/bluetooth_desc"
                android:src="@drawable/ic_bluetooth"
                app:tint="@color/amber_primary" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/bt_disconnected"
                android:textColor="@color/amber_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusBadgeDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_pill_amber"
                android:backgroundTint="@color/amber_primary" />
        </LinearLayout>

        <!-- GPS Location Indicator Chip -->
        <LinearLayout
            android:id="@+id/gpsStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_cyan"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/gps_sensor_desc"
                android:src="@drawable/ic_gps"
                app:tint="@color/cyan_gps" />

            <TextView
                android:id="@+id/gpsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:text="@string/gps_acquiring"
                android:textColor="@color/cyan_gps"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Section Divider -->
    <TextView
        android:id="@+id/dispatchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:text="@string/dispatch_profiles_title"
        android:textColor="@color/sos_red_light"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusDashboardCard" />

    <TextView
        android:id="@+id/dispatchSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="@string/dispatch_profiles_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dispatchTitle" />

    <!-- Emergency Profiles Container ScrollView -->
    <ScrollView
        android:id="@+id/sosContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dispatchSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Medical & Fire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosMedicalButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_medical_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosFireButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_fire_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Row 2: Security & Trapped -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosSecurityButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_security_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosTrappedButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_trapped_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Row 3: Hazmat & Flood -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosHazmatButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_hazmat_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosFloodButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_flood_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Row 4: Weather & Food/Water -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosWeatherButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_weather_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosFoodWaterButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_supplies_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Row 5: Extraction & Other -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosExtractionButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_extraction_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosOtherButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sos_card_bg"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="@string/sos_other_text"
                    android:textColor="@color/sos_red_light"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/sos_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Terminal Toggle Button (Bottom Right) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnToggleTerminal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/terminal_toggle_desc"
        android:src="@drawable/ic_terminal"
        app:backgroundTint="@color/amber_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/bg_dark" />

    <!-- Bluetooth Serial Terminal Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/terminalOverlayCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#121212"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/amber_primary"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Terminal Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/terminalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/btnCloseTerminal"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:text="@string/terminal_title"
                    android:textColor="@color/amber_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseTerminal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close_terminal_desc"
                    android:src="@drawable/ic_close"
                    app:tint="@color/amber_primary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <!-- Terminal Messages Log ScrollView -->
            <ScrollView
                android:id="@+id/terminalScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/terminalLogTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/terminal_ready"
                    android:textColor="#00FF66"
                    android:textSize="12sp" />
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>