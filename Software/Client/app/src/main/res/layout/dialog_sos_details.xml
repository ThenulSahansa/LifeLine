<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Emergency Category Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogCategoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/sos_red_light"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="🚨 MEDICAL" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_red"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/priority_one"
            android:textColor="@color/sos_red"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preset Message Container (Shown for standard profiles) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogPresetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/sos_card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sos_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_broadcast_label"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogBaseMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="We need Medical assistance (Critical Injury)" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Input Field 1: Type of Emergency (Shown for Custom / Other option) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialogCustomTypeLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/type_of_emergency_hint"
        android:visibility="gone"
        app:boxBackgroundColor="@color/bg_dark"
        app:boxStrokeColor="@color/sos_red"
        app:hintTextColor="@color/sos_red_light">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogCustomTypeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Attached Location Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_cyan"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/gps_sensor_desc"
            android:src="@drawable/ic_gps"
            app:tint="@color/cyan_gps" />

        <TextView
            android:id="@+id/dialogGpsLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/cyan_gps"
            android:textSize="11sp"
            tools:text="GPS: 37.774900, -122.419400" />
    </LinearLayout>

    <!-- Input Field 2: Description / Additional Details -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialogInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/description_hint"
        app:boxBackgroundColor="@color/bg_dark"
        app:boxStrokeColor="@color/sos_red"
        app:hintTextColor="@color/sos_red_light">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>